--- a/scripts/worktree-create-handler.sh
+++ b/scripts/worktree-create-handler.sh
@@ -50,9 +50,26 @@
 
 INPUT=$(cat)
 
-worktree_name=$(printf '%s' "$INPUT" | jq -r '.worktree_name // empty' 2>/dev/null || true)
+# LOCAL PATCH (Phil's machine, 2026-10-07) — not upstream. Original backed up at
+# ~/.claude/backups/claude-workflow-4.4.1-worktree-create-handler.sh.orig
+# Claude Code sends the slug as `name`, not `worktree_name`, and sends no
+# `isolation_type` (code.claude.com/docs/en/hooks#worktreecreate-input).
+# Subagent detection: a real subagent payload (captured 2026-10-07) carried only
+# cwd, hook_event_name, name, prompt_id, scratchpad_dir, session_id and
+# transcript_path — NO agent_id, despite the docs listing it as a common field.
+# The hook fires in the parent's context, before the subagent exists. So the
+# working signal is Claude Code's `agent-<hex>` slug for subagent worktrees.
+# That naming is observed, not documented, and could change. agent_id is still
+# checked first in case a future Claude Code version starts sending it.
+worktree_name=$(printf '%s' "$INPUT" | jq -r '.worktree_name // .name // empty' 2>/dev/null || true)
 base_ref=$(printf '%s' "$INPUT" | jq -r '.base_ref // empty' 2>/dev/null || true)
-isolation_type=$(printf '%s' "$INPUT" | jq -r '.isolation_type // "user"' 2>/dev/null || echo "user")
+isolation_type=$(printf '%s' "$INPUT" | jq -r '.isolation_type // (if .agent_id then "subagent" else empty end) // empty' 2>/dev/null || true)
+if [ -z "$isolation_type" ]; then
+    case "$worktree_name" in
+        agent-*) isolation_type="subagent" ;;
+        *)       isolation_type="user" ;;
+    esac
+fi
 cwd=$(printf '%s' "$INPUT" | jq -r '.cwd // empty' 2>/dev/null || true)
 session_id=$(printf '%s' "$INPUT" | jq -r '.session_id // empty' 2>/dev/null || true)
 
