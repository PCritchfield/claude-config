.DS_Store
*.swp
*.swo
*~

# Spec working documents
docs/specs/

# Project-local skill installs (we install globally via install_skills.sh)
.agents/

# Account/org skills synced by the Claude desktop app into ~/.claude/skills/synced/.
# Because ~/.claude/skills is a stow symlink into this repo, they land in this
# working tree. App-managed, machine-specific, per-session UUID directories, and
# regenerated on demand — never commit them. (Seen: 242 files / 208k lines / 35MB.)
claude/.claude/skills/synced/

# Community skills installed by install_skills.sh (symlinks to ~/.agents/skills/)
# Only custom skills (real directories) in claude/.claude/skills/ are tracked.
# To see what should be installed: cat skills.txt
claude/.claude/skills/create-mermaid-diagrams
claude/.claude/skills/create-pull-request
claude/.claude/skills/doc-coauthoring
claude/.claude/skills/find-skills
claude/.claude/skills/git-commit
claude/.claude/skills/git-commit-conventional


# Editor/tool configs (root-level only, not claude/.claude/ stow source)
/.claude/
/.windsurf/

# Python bytecode, e.g. from importing the validator or sync script in tests.
__pycache__/

# Installed by omarchy on Omarchy desktops; links into ~/.local/share/omarchy.
claude/.claude/skills/omarchy

# Installed by herdr into ~/.claude/hooks (this working tree, through stow) and
# overwritten on every herdr update.
claude/.claude/hooks/herdr-agent-state.sh
